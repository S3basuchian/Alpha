# Rendered by setup.sh — contains machine-specific absolute paths. Commit the *.json.in
# templates, not the rendered configs.
*.json
!*.json.in

# Seed-expanded instance lists — generated by setup.sh from the committed *.sizes grids
# (one row per (size, seed); NUM_SAMPLES/BASE_SEED configurable). Commit the *.sizes, not these.
*.instances

# copperbench output / postprocessor artifacts, if a run is launched from inside this dir.
groundexp/
cutedge/
reach/
coloring/
results_long.csv
results_wide.csv
tables.tex
gardener/
