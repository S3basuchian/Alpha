{
    "name": "reach",
    "executable": "bash __REPO_ROOT__/experiments/copperbench/wrappers/run-reach.sh",
    "configs": "__REPO_ROOT__/experiments/copperbench/reach.configs",
    "instances": "__REPO_ROOT__/experiments/copperbench/reach.instances",
    "instances_are_parameters": true,
    "working_dir": "__REPO_ROOT__",
    "timeout": 300,
    "mem_limit": 16000,
    "request_cpus": 1,
    "runs": 3,
    "use_perf": false,
    "postprocess_stdout_regex": "RESULT_SECONDS=([0-9.]+)",
    "partition": "__PARTITION__"
}
