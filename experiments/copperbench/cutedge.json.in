{
    "name": "cutedge",
    "executable": "bash __REPO_ROOT__/experiments/copperbench/wrappers/run-cutedge.sh",
    "configs": "__REPO_ROOT__/experiments/copperbench/cutedge.configs",
    "instances": "__REPO_ROOT__/experiments/copperbench/cutedge.instances",
    "instances_are_parameters": true,
    "working_dir": "__REPO_ROOT__",
    "timeout": 300,
    "mem_limit": 16000,
    "request_cpus": 1,
    "runs": 3,
    "max_parallel_jobs": 20,
    "exclusive": true,
    "use_perf": false,
    "postprocess_stdout_regex": "RESULT_SECONDS=([0-9.]+)",
    "partition": "__PARTITION__",
    "runsolver_path": "__RUNSOLVER__",
    "clearcache_path": "__CLEARCACHE__"
}
