{
    "name": "coloring-grow",
    "executable": "bash __REPO_ROOT__/experiments/copperbench/wrappers/run-coloring-grow.sh",
    "configs": "__REPO_ROOT__/experiments/copperbench/coloring-grow.configs",
    "instances": "__REPO_ROOT__/experiments/copperbench/coloring-grow.instances",
    "instances_are_parameters": true,
    "working_dir": "__REPO_ROOT__",
    "timeout": 3600,
    "mem_limit": 64000,
    "request_cpus": 1,
    "runs": 1,
    "use_perf": false,
    "postprocess_stdout_regex": "RESULT_SECONDS=([0-9.]+)",
    "partition": "__PARTITION__"
}
